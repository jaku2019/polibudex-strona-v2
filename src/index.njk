---
layout: layouts/base.njk
title: Strona główna
---

<!-- Hero / Splash Section -->
<section class="hero hero-splash" aria-label="Baner główny">
  <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-3" aria-hidden="true"></div>

  <div class="hero-splash-inner">
    <div class="hero-splash-logo">
      <img src="/assets/images/polibudex_transparent_color.png" alt="{{ site.nazwa }}" class="hero-splash-logo-img">
    </div>
    <p class="hero-splash-subtitle">{{ homepage.hero_slogan }}</p>
  </div>

  <div class="hero-scroll-indicator" aria-hidden="true">
    <span></span>
  </div>
</section>

<!-- O nas Section -->
<section class="section-onas" aria-labelledby="onas-title">
  <div class="container">
    <h2 id="onas-title">{{ homepage.onas_tytul }}</h2>
    <div class="onas-content">
      {{ homepage.onas_tresc | safe }}
    </div>
  </div>
</section>

<!-- Wyróżnione posty -->
<section class="section-posty" aria-labelledby="posty-title">
  <div class="container">
    <div class="section-header">
      <h2 id="posty-title">Najnowsze posty</h2>
      <a href="/posty/" class="btn btn-secondary">Zobacz wszystkie</a>
    </div>
    <div class="posts-grid">
      {% for post in collections.posty | limit(3) %}
        {% set post = post %}
        {% include "components/post-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- Nasze odnogi -->
<section class="section-odnogi" aria-labelledby="odnogi-title">
  <div class="container">
    <h2 id="odnogi-title">Nasze odnogi</h2>
    <div class="odnogi-grid">
      {% for odnoga in homepage.odnogi %}
      <a href="{{ odnoga.link }}" class="odnoga-card" {% if odnoga.link == '#' %}aria-disabled="true"{% endif %}>
        <div class="odnoga-icon" aria-hidden="true">{{ odnoga.ikona }}</div>
        <h3>{{ odnoga.nazwa }}</h3>
        <p>{{ odnoga.opis }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
